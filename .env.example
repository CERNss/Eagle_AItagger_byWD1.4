# Eagle AI Tagger — secrets and machine-specific overrides.
#
# Copy this file to .env and fill in real secrets:
#   cp .env.example .env
#
# .env is git-ignored. Values here are loaded into the process environment and
# can be referenced from config.yaml via ${VAR} / ${VAR:-default}.
# Anything set here also overrides config.yaml (env wins over yaml).

# Auth headers for the OpenTelemetry OTLP collector (comma-separated key=value).
# Referenced by config.yaml: otel_exporter_headers: ${OTEL_EXPORTER_HEADERS:-}
# OTEL_EXPORTER_HEADERS=Authorization=Bearer <token>

# Host directory shared into the container as /data/images (used by docker-compose).
# IMAGE_ROOT=/srv/shared-images
